# Application
SECRET_KEY=change-this-in-production
PUBLIC_BASE_URL=http://127.0.0.1:8080
GOOGLE_API_KEY=

# Codex Runner (services/codex-runner). 앱과 러너 양쪽에 같은 시크릿을 넣습니다.
CODEX_RUNNER_URL=
CODEX_RUNNER_SHARED_SECRET=
ACCOUNT_IDENTITY_SECRET=

# Web search for the experiment chat.
# Codex 자체 웹 검색(러너에서 web_search="live")이 1순위이고, 아래는 예비 경로입니다.
# 검색 결과를 가져오는 데만 쓴다 — 자료를 읽고 정리하는 것은 Codex가 한다.
# 아래 중 하나만 채우면 된다. 비어 있으면 검색 기능이 꺼지고, Agent는
# "웹에 닿을 수 없다"고 말한 뒤 학생에게 검색어를 알려준다.
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Student-number renewal email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DOC Agent
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Reminder scan interval (minimum 3600 seconds, default once per day)
STUDENT_NUMBER_REMINDER_INTERVAL_SECONDS=86400

# Dev-only seed router at /api/test/* (never enable in production).
# Creates throwaway test_* users; they are purged when the session cookie or
# the server process is reset.
DEV_TEST_ROUTES=0
