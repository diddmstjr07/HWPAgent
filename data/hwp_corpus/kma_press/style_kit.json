      "marker": "[[DESIGN:contact_box:담당 부서:부서명|책임자:직위 이름|담당자:직위 이름]]",
      "implementation": {
        "type": "table_surrogate",
        "rows": 3,
        "cols": 2,
        "colors": {
          "labelFill": "#e8eef6",
          "line": "#7f8ea3"
